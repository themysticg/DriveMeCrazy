<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Product>DriveMeCrazy</Product>
    <Authors>DriveMeCrazy contributors</Authors>
    <Copyright>Copyright (c) 2026 DriveMeCrazy contributors</Copyright>
    <Description>Free, open-source updater for Windows drivers, firmware, Windows updates and Microsoft Store apps.</Description>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>DriveMeCrazy</AssemblyName>
    <RootNamespace>DriveMeCrazy.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Release builds ask for admin (needed to install updates). Developers can build with
         -p:DmcAsInvoker=true to run unelevated (scan only). -->
    <ApplicationManifest Condition="'$(DmcAsInvoker)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(DmcAsInvoker)' == 'true'">app.asinvoker.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriveMeCrazy.Core\DriveMeCrazy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>

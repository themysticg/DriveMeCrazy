<UserControl x:Class="DriveMeCrazy.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DriveMeCrazy.Core.Models;assembly=DriveMeCrazy.Core">
    <Grid Margin="32,26,32,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0" />
                <Button Content="Clear history" Command="{Binding Main.ClearHistoryCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="History" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Everything DriveMeCrazy has installed on this PC." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="Nothing installed yet." Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Main.IsHistoryEmpty, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Main.History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:HistoryEntry}">
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,4,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Mark" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource GoodBrush}" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding Kind, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Result, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                <Setter TargetName="Mark" Property="Text" Value="&#xE711;" />
                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource BadBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

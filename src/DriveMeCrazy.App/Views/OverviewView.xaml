<UserControl x:Class="DriveMeCrazy.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DriveMeCrazy.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,24" MaxWidth="1060">

            <!-- Hero -->
            <Border CornerRadius="14" Background="{StaticResource BrandGradient}" Padding="30,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Main.HeroTitle}" FontSize="30" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Main.HeroSubtitle}" Foreground="#E6FFFFFF" FontSize="14" Margin="0,8,0,22" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
                        <WrapPanel>
                            <Button Style="{StaticResource HeroButton}" Command="{Binding Main.ScanCommand}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" FontSize="14" />
                                    <TextBlock Text="Check for updates" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeroGhostButton}" Command="{Binding Main.InstallRecommendedCommand}"
                                    Visibility="{Binding Main.HasRecommended, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" FontSize="14" />
                                    <TextBlock Text="{Binding Main.InstallAllText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeroGhostButton}" Command="{Binding Main.ReviewOldDriversCommand}" Margin="10,0,0,0"
                                    Visibility="{Binding Main.HasCatalogFound, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE772;" Margin="0,0,8,0" FontSize="14" />
                                    <TextBlock Text="{Binding Main.ReviewDriversText}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                    <Image Grid.Column="1" Source="/Assets/logo.png" Width="112" Height="112" Margin="24,0,0,0" Opacity="0.95"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <!-- Source tiles -->
            <ItemsControl ItemsSource="{Binding Main.Sources}" Margin="-6,18,-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SourceState}">
                        <Button Style="{StaticResource TileButton}" Margin="6"
                                Command="{Binding DataContext.Main.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource NeutralBg}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Tag="{Binding Tone}" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ShortMessage}" Style="{StaticResource BadgeText}" ToolTip="{Binding Message}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="{Binding CountText}" FontSize="36" FontWeight="Bold" Margin="0,14,0,0" />
                                <TextBlock Grid.Row="2" Text="{Binding Title}" Style="{StaticResource Secondary}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Info cards -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="22" Foreground="{StaticResource WarnBrush}" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="{Binding Main.OldDriverCount, Mode=OneWay}" /> <Run Text="old drivers" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,8" Text="{Binding Main.OldDriversSummary}" />
                            <Button Style="{StaticResource LinkButton}" Content="Review old drivers →" HorizontalAlignment="Left"
                                    Command="{Binding Main.ReviewOldDriversCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="22" Foreground="{StaticResource GoodBrush}" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Safe by design" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,4"
                                       Text="Only Microsoft-signed updates from Windows Update and the Microsoft Store. Nothing is downloaded from third-party sites, and licence terms are never accepted for you." />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="Restore point:" /> <Run Text="{Binding Main.RestoreSetting, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="DriveMeCrazy.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DriveMeCrazy.App.ViewModels"
             xmlns:views="clr-namespace:DriveMeCrazy.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="32,26,32,0">
            <TextBlock Text="Drivers &amp; firmware" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,8"
                       Text="Signed drivers and firmware from Microsoft's Windows Update catalog, matched to the exact hardware IDs in this PC." />
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Margin="20,0,20,0" BorderThickness="0" Background="Transparent">
            <TabItem Header="Available updates">
                <views:UpdateListView DataContext="{Binding Updates}" Margin="-20,0,-20,0" />
            </TabItem>
            <TabItem Header="{Binding OldDriversHeader}">
                <Grid Margin="12,16,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,12" Text="{Binding Main.OldDriversSummary}" />
                    <DockPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Padding="16,7" Margin="8,0,0,0"
                                Command="{Binding Main.InstallCatalogDriversCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Main.CatalogInstallText}" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding Main.FindCatalogDriversCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Find newer drivers" />
                            </StackPanel>
                        </Button>
                        <CheckBox Content="Show all drivers" IsChecked="{Binding ShowAllDrivers}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding DriverRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False"
                              SelectionMode="Single" SelectionUnit="Cell" RowHeight="52">
                        <DataGrid.Resources>
                            <Style x:Key="Cell" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Margin" Value="6,0" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriverRowViewModel}">
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                                  MinWidth="0" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriverRowViewModel}">
                                        <Border Style="{StaticResource Badge}" Tag="{Binding StatusTone}" Margin="6,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Device" Width="2.4*" MinWidth="220" SortMemberPath="Device">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriverRowViewModel}">
                                        <StackPanel VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding Device}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Device}" />
                                            <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding Class, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Provider, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="Auto" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="Auto" SortMemberPath="Age" ElementStyle="{StaticResource Cell}" />
                            <DataGridTemplateColumn Header="Newer driver" Width="1.6*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriverRowViewModel}">
                                        <Border Style="{StaticResource Badge}" Tag="{Binding NewerTone}" Margin="6,0" HorizontalAlignment="Left"
                                                ToolTip="{Binding Lookup.Best.Title}">
                                            <TextBlock Text="{Binding NewerText}" Style="{StaticResource BadgeText}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriverRowViewModel}">
                                        <Button Command="{Binding SearchOnlineCommand}" Padding="8,5" Margin="6,0" VerticalAlignment="Center"
                                                ToolTip="Search the web for this device's driver (manufacturer's site)">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="DriveMeCrazy.App.Views.UpdateListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DriveMeCrazy.App.ViewModels">
    <Grid Margin="32,26,32,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallSelectedCommand}" Padding="16,7" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding InstallText}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Content="{Binding ExternalActionText}" Command="{Binding OpenExternalCommand}"
                    Visibility="{Binding HasExternalAction, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Select recommended" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0" />
                <Button Content="Select none" Command="{Binding SelectNoneCommand}" Margin="0,0,16,0" />
                <TextBlock Text="{Binding Source.Message}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Badge}" Tag="{Binding EmptyTone}" HorizontalAlignment="Center" CornerRadius="32" Padding="14" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding EmptyGlyph}" FontSize="32" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Secondary}" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UpdateItemViewModel}">
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,4,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="{StaticResource NeutralBg}" Margin="4,0,14,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="17" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar Width="160" Height="4" VerticalAlignment="Center" Margin="0,0,10,0" Maximum="100"
                                                         IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding PercentValue, Mode=OneWay}"
                                                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                                            <Border Style="{StaticResource Badge}" Tag="{Binding StateTone}">
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="3" Style="{StaticResource Badge}" Tag="{Binding BadgeTone}" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource Caption}" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

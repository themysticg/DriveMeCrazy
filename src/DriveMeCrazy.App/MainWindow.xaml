<Window x:Class="DriveMeCrazy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DriveMeCrazy.App.ViewModels"
        xmlns:views="clr-namespace:DriveMeCrazy.App.Views"
        Title="DriveMeCrazy" Width="1200" Height="780" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewPageViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversPageViewModel}"><views:DriversView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdateListViewModel}"><views:UpdateListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryPageViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,12,22">
                <Image Source="Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DriveMeCrazy" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Free &amp; open-source updater" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="20,0,16,0">
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource WarnBrush}" />
                    <TextBlock Text="Not running as admin – scan only" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                     ItemContainerStyle="{StaticResource NavItem}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <Border Grid.Column="2" CornerRadius="9" MinWidth="22" Padding="6,1"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Content -->
        <Border Grid.Column="1" CornerRadius="10,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Restart banner -->
                <Border Grid.Row="0" Margin="24,16,24,0" Padding="16,10" CornerRadius="8"
                        Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                        Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Foreground="{StaticResource WarnBrush}" Margin="0,0,10,0" />
                        <Button DockPanel.Dock="Right" Content="Later" Command="{Binding DismissRestartCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Restart now" Command="{Binding RestartNowCommand}" Style="{DynamicResource AccentButtonStyle}" />
                        <TextBlock Text="Restart your PC to finish installing updates." VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding SelectedNav.Page}" Focusable="False" />

                <!-- Status bar -->
                <Border Grid.Row="2" Padding="24,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Margin="12,0,0,0"
                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />
                        <ProgressBar DockPanel.Dock="Right" Width="180" Height="4" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Value="{Binding ProgressValue, TargetNullValue=0}" Maximum="100"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="IsIndeterminate" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProgressValue}" Value="{x:Null}">
                                            <Setter Property="IsIndeterminate" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
